<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lxwise.net</groupId>
    <artifactId>network-port-tools</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>network-port-tools</name>
    <description>网络端口管理工具（network-port-tools） 是一款基于 JavaFX 开发的跨平台桌面应用， 用于帮助开发者、运维人员快速查看系统端口占用情况，并对进程进行高效管理。</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.1</javafx.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <ikonli.version>12.3.1</ikonli.version>
    </properties>

    <dependencies>
        <!-- JavaFX 核心模块 -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- AtlantaFX 现代UI主题库 -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Ikonli 图标库 -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>${ikonli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-material2-pack</artifactId>
            <version>${ikonli.version}</version>
        </dependency>

        <!-- 工具库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.40</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.12</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>network-port-tools</finalName>
        <plugins>
            <plugin>
                <groupId>io.github.lxwise</groupId>
                <artifactId>jfx-maven-plugin</artifactId>
                <version>1.1.0</version>
                <configuration>
                    <type>${APP_TYPE}</type>
                    <name>network-port-tools</name>
                    <mainClass>com.lxwise.net.PortAppLauncher</mainClass>
                    <addModules>java.base,java.desktop,java.logging,java.scripting,jdk.jfr</addModules>
                    <jlinkOptions>
                        <option>--strip-native-commands</option>
                        <option>--strip-debug</option>
                        <option>--no-man-pages</option>
                        <option>--no-header-files</option>
                        <option>--compress</option>
                        <option>zip-9</option>
                    </jlinkOptions>
                    <!-- macOS 配置 -->
                    <macPackageIdentifier>network-port-tools</macPackageIdentifier>
                    <!-- Linux 配置 -->
                    <linuxMenuGroup>System</linuxMenuGroup>
                    <linuxPackageName>network-port-tools</linuxPackageName>
                    <linuxShortcut>true</linuxShortcut>
                    <!-- Windows 配置 -->
                    <winDirChooser>true</winDirChooser>
                    <winMenu>true</winMenu>
                    <winShortcut>true</winShortcut>
                    <winPerUserInstall>true</winPerUserInstall>
                    <winShortcutPrompt>true</winShortcutPrompt>
                    <!-- 通用配置 -->
                    <vendor>lxwise</vendor>
                    <copyright>版权@lxwise</copyright>
                    <description>网络端口管理工具 - 跨平台桌面应用</description>
                    <options>
                        <option>-Xms32m</option>
                        <option>-Xmx128m</option>
                        <option>-Dfile.encoding=UTF-8</option>
                        <option>-Dprism.vsync=false</option>
                        <option>-Djavafx.animation.fullspeed=true</option>
                        <option>-Dsun.java2d.allowhidpi=false</option>
                        <option>-XX:+UnlockExperimentalVMOptions</option>
                        <option>-XX:+UseCompactObjectHeaders</option>
                        <option>-XX:+UseStringDeduplication</option>
                        <option>-XX:TieredStopAtLevel=1</option>
                        <option>-XX:GCTimeRatio=95</option>
                        <option>-XX:+G1UseAdaptiveIHOP</option>
                        <option>-XX:MaxMetaspaceFreeRatio=50</option>
                        <option>-XX:MinMetaspaceFreeRatio=20</option>
                        <option>-XX:G1PeriodicGCInterval=500</option>
                        <option>-XX:InitiatingHeapOccupancyPercent=20</option>
                        <option>-XX:MaxHeapFreeRatio=10</option>
                        <option>-XX:MinHeapFreeRatio=3</option>
                        <option>-XX:G1HeapWastePercent=3</option>
                        <option>-XX:G1ReservePercent=5</option>
                        <option>-XX:G1MixedGCCountTarget=1</option>
                        <option>-XX:MaxGCPauseMillis=30</option>
                        <option>-Dprism.maxvram=2G</option>
                        <option>-Dprism.order=es2</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
